%%%
# Gaussian regression and prediction

The training covariance includes observation noise and numerical jitter before
conditioning. Cross-covariances contain latent process covariance only.
%%%
flatppl_compat = "0.1"
linalg = standard_module("ext-linear-algebra", "0.1")

% K + diag(noise_sd.^2 + jitter); K is n by n, noise_sd is scalar or length n.
observation_covariance(covariance, noise_sd, jitter) = covariance + diagmat(
    zeros(sizeof(covariance)[1]) .+ noise_sd.^2 .+ jitter
)

% MvNormal(mean, K + diag(noise_sd.^2 + jitter)); mean has length n.
gaussian_regression(mean, covariance, noise_sd, jitter) =
    MvNormal(mean, observation_covariance(covariance, noise_sd, jitter))

# One triangular matrix solve whitens all prediction columns together.
_conditional_whitened(observed, mean_train, factor, mean_test, covariance_test, whitened) = record(
    mean = mean_test + transpose(whitened) * linalg.solve_triangular(factor, observed - mean_train),
    covariance = covariance_test - col_gram(whitened)
)
_conditional_factored(observed, mean_train, factor, mean_test, cross_covariance, covariance_test) =
    _conditional_whitened(observed, mean_train, factor, mean_test, covariance_test,
        linalg.solve_triangular(factor, cross_covariance))

% Joint latent conditional moments; training C is n by n, cross B is n by m.
conditional_moments(observed, mean_train, covariance_train, mean_test, cross_covariance, covariance_test) =
    _conditional_factored(observed, mean_train, lower_cholesky(covariance_train),
        mean_test, cross_covariance, covariance_test)

% Joint predictive law; noise_sd = 0 gives latent prediction with explicit jitter.
predictive_law(moments, noise_sd, jitter) =
    gaussian_regression(moments.mean, moments.covariance, noise_sd, jitter)
